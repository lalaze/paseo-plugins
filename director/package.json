{
  "name": "paseo-director",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Configurable design, execution and review workflows for Paseo",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/locale.mjs --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/client": "0.8.0",
    "@getpaseo/protocol": "0.8.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
